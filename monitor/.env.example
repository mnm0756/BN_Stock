# auto: try Binance first and fall back to clearly-labelled demo data
# live: return an error instead of demo data when Binance is unavailable
# demo: always use deterministic sample data
MONITOR_PROVIDER_MODE=auto
MONITOR_REFRESH_SECONDS=15

# Change this to an eligible, trusted reverse proxy only when required.
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

