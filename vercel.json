{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "monitor/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/monitor/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/monitor/static/index.html"
    }
  ],
  "env": {
    "DATABASE_PATH": "/tmp/bn_stock_monitor.db",
    "MONITOR_PROVIDER_MODE": "auto"
  }
}
